# ====================================================================
# Configuração Apache / LiteSpeed cPanel HomeHost
# AcertGo - Subdomínio / Pasta do CRM (public_html/aicrm/)
# Controle Estrito de Cache & Roteamento SPA
# ====================================================================

# 1. Desativar LiteSpeed Cache no servidor (evita cache de HTML pelo servidor)
<IfModule LiteSpeed>
  CacheLookup off
  CacheDisable
</IfModule>

# 2. Desativar ETag para forçar navegadores a sempre buscarem a versão mais recente
<IfModule mod_headers.c>
  Header always unset ETag
</IfModule>
FileETag None

# 3. Regras de Reescrita & SPA Routing para o CRM
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forçar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirecionar acessos à página de vendas feitos no CRM para o domínio principal
  RewriteCond %{HTTP_HOST} ^aicrm\.acertgo\.com\.br$ [NC]
  RewriteRule ^(vendas|lp|sales)/?$ https://acertgo.com.br/ [R=301,L]

  # Arquivos e diretórios físicos existentes são servidos normalmente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA Routing: Redirecionar todas as rotas da aplicação para index.html
  RewriteRule ^ index.html [L]
</IfModule>

# 4. Controle Rígido de Cache: No-Cache Estrito para index.html e páginas HTML
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set Surrogate-Control "no-store"
  </FilesMatch>

  # Assets versionados com hash único gerado pelo Vite (imutáveis por 1 ano)
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Configuração de Expiração mod_expires
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# 5. Compressão GZIP / Deflate para alta velocidade
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 6. Cabeçalhos de Segurança
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
